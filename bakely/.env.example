# Copie este archivo como .env y ajuste los valores
DJANGO_SECRET_KEY=genere-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (use DB_ENGINE=sqlite solo para pruebas rápidas)
DB_ENGINE=mysql
DB_NAME=bakely_db
DB_USER=bakely
DB_PASSWORD=cambia-esta-clave
DB_HOST=127.0.0.1
DB_PORT=3306

# Planta y CEDI
PLANTA_CODIGO=UPEC-PAL-01
CEDI_CODIGO=CEDI-CARCHI-01
CEDI_API_URL=
CEDI_API_TOKEN=token-compartido-con-el-cedi

# IoT: clave que envían los ESP32 / Node-RED en la cabecera X-Device-Key
IOT_DEVICE_KEY=clave-larga-para-dispositivos
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=upec/bakely/+/+

# Odoo (XML-RPC)
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=
